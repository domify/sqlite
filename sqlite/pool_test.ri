# crystal-sqlite3's spec/pool_spec.cr: tasks writing to one file. A connection
# belongs to the task that opened it (SPEC 5.1), so each opens its own; they
# take turns through SQLite's lock, as the fibers on a pool's connections did.
module sqlite/pool_test

import db/db/db
import db/db/spec::{describe, it}
import sqlite/testing/spec_helper::*

describe "several connections" do
  it "should write from multiple connections" do
    fibers = 5
    max_n = 50
    with_db do |db|
      db.exec("create table numbers (n integer, fiber integer)").or_panic

      group do |g|
        fibers.times do |f|
          g.spawn do
            ::Db::Db.open("sqlite3:#{DB_FILENAME}?busy_timeout=5000") do |task_db|
              (1..max_n).each do |n|
                task_db.exec("insert into numbers (n, fiber) values (?, ?)", n, f).or_panic
                sleep 10
              end
            end.or_panic
            0
          end
        end
      end

      # all numbers were inserted
      s = fibers * max_n * (max_n + 1) // 2
      db.scalar("select sum(n) from numbers") { |value| assert value == s }.or_panic

      # numbers were not inserted one fiber at a time
      rows = db.query_all("select n, fiber from numbers", as: Tuple(Int32, Int32)).or_panic
      fibers_in_order = rows.map { |row| row[1] }
      assert fibers_in_order != fibers_in_order.sorted
    end
  end
end
